<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/xpquests/db" VERSION="20261003" COMMENT="XMLDB file for local_xpquests"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_xpquests_quests" COMMENT="Quest definitions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="image" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="sequential" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeend" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="repeatable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="maxcompletions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="rewardxp" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="rewardcredits" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_enabled_sort" UNIQUE="false" FIELDS="courseid, enabled, sortorder"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_xpquests_steps" COMMENT="Quest steps">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="steptype" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="configjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="optional" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questid" TYPE="foreign" FIELDS="questid" REFTABLE="local_xpquests_quests" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="quest_sort" UNIQUE="false" FIELDS="questid, sortorder"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_xpquests_progress" COMMENT="Separate quest execution records">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="inprogress"/>
        <FIELD NAME="currentstep" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="startedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="completioncount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="runnumber" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="startxp" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questid" TYPE="foreign" FIELDS="questid" REFTABLE="local_xpquests_quests" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="quest_user_run" UNIQUE="true" FIELDS="questid, userid, runnumber"/>
        <INDEX NAME="user_status" UNIQUE="false" FIELDS="userid, status"/>
        <INDEX NAME="quest_status" UNIQUE="false" FIELDS="questid, status"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_xpquests_step_progress" COMMENT="Completed quest steps by execution">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="progressid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="stepid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="completed"/>
        <FIELD NAME="completedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questid" TYPE="foreign" FIELDS="questid" REFTABLE="local_xpquests_quests" REFFIELDS="id"/>
        <KEY NAME="progressid" TYPE="foreign" FIELDS="progressid" REFTABLE="local_xpquests_progress" REFFIELDS="id"/>
        <KEY NAME="stepid" TYPE="foreign" FIELDS="stepid" REFTABLE="local_xpquests_steps" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="progress_step" UNIQUE="true" FIELDS="progressid, stepid"/>
        <INDEX NAME="quest_user" UNIQUE="false" FIELDS="questid, userid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_xpquests_rewards" COMMENT="Idempotent quest reward delivery ledger">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="progressid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="rewardtype" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="amount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="externalref" TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="progressid" TYPE="foreign" FIELDS="progressid" REFTABLE="local_xpquests_progress" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="progress_reward" UNIQUE="true" FIELDS="progressid, rewardtype"/>
        <INDEX NAME="reward_status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
